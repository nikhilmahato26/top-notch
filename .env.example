# ===================================================
# TOP NOTCH BY NIK - ENVIRONMENT CONFIGURATION
# ===================================================

# 1. Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=topnotch2026
ADMIN_JWT_SECRET=top-notch-secret-key-change-this-in-production-2026

# 2. Mollie Payment Gateway
# Obtain from https://www.mollie.com/dashboard/developers/api-keys
# Use 'test_...' for testing or 'live_...' for real customer charges
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOLLIE_CURRENCY=DKK
# Optional webhook for live status callbacks:
# MOLLIE_WEBHOOK_URL=https://your-domain.com/api/mollie-webhook

# 3. SMTP Mail Configuration (Nodemailer)
# Works with Gmail (App Password), Mailgun, SendGrid, Amazon SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="Top Notch by Nik <your-email@gmail.com>"

# 4. App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
